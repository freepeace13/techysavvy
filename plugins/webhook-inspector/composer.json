{
    "name": "techysavvy/webhook-inspector",
    "description": "Get a throwaway URL and watch incoming webhooks arrive live.",
    "type": "library",
    "version": "1.0.0",
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "techysavvy/core": "*",
        "techysavvy/ui": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Techysavvy\\WebhookInspector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Techysavvy\\WebhookInspector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Techysavvy\\WebhookInspector\\WebhookInspectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
